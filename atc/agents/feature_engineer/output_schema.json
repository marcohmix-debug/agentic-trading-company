{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "feature_engineer output contract",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "SUCCEEDED",
        "NO_OP",
        "FAILED"
      ]
    },
    "reason": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "table",
              "data"
            ],
            "properties": {
              "table": {
                "const": "feature_sets"
              },
              "data": {
                "type": "object",
                "required": [
                  "base_dataset_id",
                  "name",
                  "transform_json"
                ],
                "properties": {
                  "base_dataset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "transform_json": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object"
                    }
                  },
                  "feature_columns_json": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_quality": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
