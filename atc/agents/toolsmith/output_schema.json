{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "toolsmith output contract",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "SUCCEEDED",
        "NO_OP",
        "FAILED"
      ]
    },
    "reason": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "table",
              "data"
            ],
            "properties": {
              "table": {
                "const": "tools"
              },
              "data": {
                "type": "object",
                "required": [
                  "name",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "test_status": {
                    "type": "string"
                  },
                  "status": {
                    "const": "PROPOSED"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
